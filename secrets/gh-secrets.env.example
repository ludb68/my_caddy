# =============================================================================
#  GitHub Actions 凭据占位文件（模板，可提交进仓库）
# =============================================================================
#  用法：
#    1) cp secrets/gh-secrets.env.example secrets/gh-secrets.env
#    2) 按下面注释去各平台生产凭据，粘到 secrets/gh-secrets.env（等号后面直接粘，别加引号）
#    3) pwsh -File secrets/apply-secrets.ps1      # 自动写进 GitHub（需要 gh CLI）
#       没有 gh CLI 就按脚本打印的清单手动贴到仓库 Settings → Secrets and variables → Actions
#    4) secrets/gh-secrets.env 已在 .gitignore 里，千万别提交、别贴聊天
# =============================================================================


# ---- ① 必需：Docker Hub 推送镜像用 ----
# Docker Hub → 右上头像 → Account settings → Personal access tokens
#   → Generate new token，名字如 gh-actions-my-caddy，Permissions 选 Read & Write
# 注意：Docker Hub 的 token 是账号级的，不能只授权某个仓库 → 只放进本仓库的 Secrets
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# ---- ② 必需：镜像推到哪个仓库（GitHub Actions Variable，不是 Secret）----
# 格式 owner/repo，全小写；不填则 CI 默认用 <GitHub用户名>/caddy-custom
# 想好仓库名后可以先去 https://hub.docker.com/repository/create 建好（Public/Private 自选）
DOCKERHUB_REPO=

# ---- ③ 可选：GitHub PAT，仅当要用脚本自动建仓 / 推送代码 / 写 Secrets 时才需要 ----
# https://github.com/settings/tokens → Fine-grained token 或 Classic token
#   需要 scopes：repo、workflow（Classic）；其实你本地 git 能 push 就不用填
GITHUB_REPO=
GH_TOKEN=

# ---- ④ 可选：覆盖 CI 默认校验（GitHub Actions Variable）----
# EXPECT_MODULES：verify job 断言这些模块 ID 必须编译进去（不填 = 三个插件对应的三个）
#                 只留 trusted proxies 时改成：http.ip_sources.cloudflare
# VERIFY_MODULES：Dockerfile 构建时 grep -E 的关键字（不填 = cloudflare）
EXPECT_MODULES=
VERIFY_MODULES=


# =============================================================================
#  运行时凭据（不属于 CI，填到 ~/.pi/secrets/my_caddy_runtime.env）
#    - WeidiDeng/caddy-cloudflare-ip 插件本身：不需要任何凭据
#    - 只有 Caddyfile 启用 tls { dns cloudflare {env.CF_API_TOKEN} } 才需要 CF token
# =============================================================================
